# Polymarket + Kalshi Trading Bot — Environment Secrets
# DO NOT commit this file. Copy to .env and fill in your real values.

# ── REQUIRED ──────────────────────────────────────────────
# Anthropic (Claude) — calibration agent + post-mortem
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# Polymarket wallet (Polygon network)
POLYGON_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
POLYGON_ADDRESS=0xYOUR_WALLET_ADDRESS_HERE
POLYMARKET_API_KEY=YOUR_POLYMARKET_API_KEY_HERE

# ── OPTIONAL — Add more AI models for consensus voting ────
# Get each key, then enable the model in config.json

# OpenAI GPT-4o (bull advocate, 20% weight)
OPENAI_API_KEY=

# Google Gemini Flash (bear advocate, 15% weight)
GOOGLE_API_KEY=

# DeepSeek (risk manager, 15% weight)
DEEPSEEK_API_KEY=

# Grok / xAI (primary forecaster, 30% weight)
GROK_API_KEY=

# ── OPTIONAL — Other data sources ────────────────────────
# Kalshi (US-regulated exchange)
KALSHI_API_KEY=

# CryptoPanic (crypto news feed)
CRYPTOPANIC_API_KEY=
